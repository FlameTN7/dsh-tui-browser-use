{
  "name": "dsh-tui-browser-use",
  "version": "0.2.0",
  "description": "Browser automation toolset for dsh-tui agents: Playwright-driven browser control with deepseek-v4-flash-vision-exp visual understanding.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FlameTN7/dsh-tui-browser-use.git"
  },
  "homepage": "https://github.com/FlameTN7/dsh-tui-browser-use",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./driver": {
      "types": "./lib/types/driver/browser-driver.d.ts",
      "default": "./lib/types/driver/browser-driver.js"
    },
    "./vision": {
      "types": "./lib/types/vision/vision-adapter.d.ts",
      "default": "./lib/types/vision/vision-adapter.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "scripts/postinstall.mjs"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "clean": "rm -rf lib",
    "compile": "npm run clean && tsc -p tsconfig.json",
    "build": "npm run compile",
    "prepack": "npm run build",
    "check": "npm run build && npm run smoke && npm run verify:manifest && npm run verify:i18n && npm run router:check",
    "postinstall": "node scripts/postinstall.mjs",
    "smoke": "node --import tsx/esm scripts/smoke.ts",
    "router:check": "node scripts/router-check.mjs",
    "test:logic": "node --import tsx/esm scripts/extract-retry-check.mjs && node --import tsx/esm scripts/vision-prompt-fence-check.mjs && node --import tsx/esm scripts/settings-live-check.mjs && node --import tsx/esm scripts/render-contract-check.mjs && node --import tsx/esm scripts/redact-check.mjs && node --import tsx/esm scripts/usage-accumulate-check.mjs && node --import tsx/esm scripts/abort-check.mjs && node --import tsx/esm scripts/file-interaction-check.mjs && node --import tsx/esm scripts/viewport-segment-check.mjs && node --import tsx/esm scripts/vision-capability-check.mjs && node --import tsx/esm scripts/download-url-check.mjs && node --import tsx/esm scripts/file-cache-scope-check.mjs && node --import tsx/esm scripts/image-pipeline-check.mjs && node --import tsx/esm scripts/runtime-env-check.mjs && node --import tsx/esm scripts/driver-contract-check.mjs",
    "test:integration": "node --import tsx/esm scripts/browser-integration.ts",
    "test:snapshot-delta": "node --import tsx/esm scripts/snapshot-delta-check.ts",
    "test:container": "node scripts/container-register-check.mjs",
    "test:tiling-defects": "node --import tsx/esm scripts/tiling-defect-check.ts",
    "test:vision": "node scripts/vision-check.mjs",
    "test:vision-cache": "node scripts/vision-cache-check.mjs",
    "test:vision-router": "node scripts/vision-router-check.mjs",
    "test:vision-textonly": "node scripts/vision-textonly-check.mjs",
    "test:vision-tiling": "node scripts/vision-tiling-check.mjs",
    "test:vision-openai-compat": "node scripts/vision-openai-compat-check.mjs",
    "test:dynamic": "node scripts/dynamic-page-check.mjs",
    "test:iframe": "node scripts/iframe-check.mjs",
    "test:engine": "node scripts/browser-engine-check.mjs",
    "test:real-task": "node scripts/real-task-check.mjs",
    "test:real-task-ddg": "node scripts/real-task-ddg.mjs",
    "test:real-extract": "node scripts/real-extract-check.mjs",
    "test:real-interact": "node scripts/real-interact-check.mjs",
    "verify:manifest": "node --import tsx/esm scripts/verify-manifest.mjs",
    "verify:i18n": "node --import tsx/esm scripts/verify-i18n.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@dsh-std/manifest": "^0.1.1-rc.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
